{
  "rules": {
    ".read": false,
    ".write": false,
    "users": {
      ".read": "root.child('users/'+auth.uid+'/role').val()==='admin'&&root.child('users/'+auth.uid+'/aktif').val()===true",
      "$uid": {
        ".read": "auth!=null&&(auth.uid===$uid||root.child('users/'+auth.uid+'/role').val()==='admin'&&root.child('users/'+auth.uid+'/aktif').val()===true)",
        ".write": "root.child('users/'+auth.uid+'/role').val()==='admin'&&root.child('users/'+auth.uid+'/aktif').val()===true",
        ".validate": "newData.hasChildren(['nama','role','aktif'])",
        "role": {
          ".validate": "newData.val().matches(/^(admin|warehouse|teknisi)$/)"
        },
        "wajibGanti": {
          ".write": "auth!=null&&auth.uid===$uid&&root.child('users/'+auth.uid+'/aktif').val()===true",
          ".validate": "newData.isBoolean()"
        }
      }
    },
    "assets": {
      ".read": "auth!=null&&root.child('users/'+auth.uid+'/aktif').val()===true",
      "$id": {
        ".write": "((root.child('users/'+auth.uid+'/role').val()==='admin'||root.child('users/'+auth.uid+'/role').val()==='warehouse')&&root.child('users/'+auth.uid+'/aktif').val()===true)||(root.child('users/'+auth.uid+'/role').val()==='teknisi'&&root.child('users/'+auth.uid+'/aktif').val()===true&&newData.child('eventId').val()===data.child('eventId').val()&&root.child('events/'+data.child('eventId').val()+'/teknisi/'+auth.uid).exists()&&((data.child('status').val()==='keluar'&&newData.child('status').val()==='diterima')||(data.child('status').val()==='diterima'&&(newData.child('status').val()==='digunakan'||newData.child('status').val()==='menunggu_kembali'))||(data.child('status').val()==='digunakan'&&newData.child('status').val()==='menunggu_kembali')))",
        ".validate": "newData.hasChildren(['kode','status'])",
        "status": {
          ".validate": "newData.val().matches(/^(tersedia|dialokasikan|disiapkan|keluar|diterima|digunakan|menunggu_kembali|servis|rusak|hilang|pensiun)$/)"
        }
      }
    },
    "events": {
      ".read": "auth!=null&&root.child('users/'+auth.uid+'/aktif').val()===true",
      "$id": {
        ".write": "(root.child('users/'+auth.uid+'/role').val()==='admin'||root.child('users/'+auth.uid+'/role').val()==='warehouse')&&root.child('users/'+auth.uid+'/aktif').val()===true",
        ".validate": "newData.hasChildren(['nama','mulai','selesai'])"
      }
    },
    "assetBookings": {
      ".read": "auth!=null&&root.child('users/'+auth.uid+'/aktif').val()===true",
      "$aid": {
        ".write": "(root.child('users/'+auth.uid+'/role').val()==='admin'||root.child('users/'+auth.uid+'/role').val()==='warehouse')&&root.child('users/'+auth.uid+'/aktif').val()===true",
        "$eid": {
          ".validate": "newData.hasChildren(['mulai','selesai'])"
        }
      }
    },
    "transactions": {
      ".read": "(root.child('users/'+auth.uid+'/role').val()==='admin'||root.child('users/'+auth.uid+'/role').val()==='warehouse')&&root.child('users/'+auth.uid+'/aktif').val()===true",
      "$tx": {
        ".write": "!data.exists()&&auth!=null&&root.child('users/'+auth.uid+'/aktif').val()===true",
        ".validate": "newData.hasChildren(['tipe','assetId','petugas','waktu'])",
        "petugas": {
          ".validate": "newData.val()===auth.uid"
        }
      },
      ".indexOn": [
        "assetId"
      ]
    },
    "audit": {
      ".read": "root.child('users/'+auth.uid+'/role').val()==='admin'&&root.child('users/'+auth.uid+'/aktif').val()===true",
      "$id": {
        ".write": "!data.exists()&&auth!=null&&root.child('users/'+auth.uid+'/aktif').val()===true",
        ".validate": "newData.child('uid').val()===auth.uid"
      }
    },
    "laporanRusak": {
      ".read": "auth!=null&&root.child('users/'+auth.uid+'/aktif').val()===true",
      "$id": {
        ".write": "!data.exists()&&auth!=null&&root.child('users/'+auth.uid+'/aktif').val()===true",
        ".validate": "newData.hasChildren(['assetId','uid','catatan','waktu'])&&newData.child('uid').val()===auth.uid"
      }
    },
    "serahTerima": {
      ".read": "auth!=null&&root.child('users/'+auth.uid+'/aktif').val()===true",
      "$eid": {
        "$rid": {
          ".write": "!data.exists()&&root.child('users/'+auth.uid+'/aktif').val()===true&&((root.child('users/'+auth.uid+'/role').val()==='admin'||root.child('users/'+auth.uid+'/role').val()==='warehouse')||root.child('events/'+$eid+'/teknisi/'+auth.uid).exists())",
          ".validate": "newData.hasChildren(['tipe','uid','waktu'])&&newData.child('uid').val()===auth.uid&&newData.child('tipe').val().matches(/^(keluar|terima|kembali)$/)"
        }
      }
    },
    "checklist": {
      "$eid": {
        ".read": "auth!=null&&root.child('users/'+auth.uid+'/aktif').val()===true",
        "$aid": {
          ".write": "((root.child('users/'+auth.uid+'/role').val()==='admin'||root.child('users/'+auth.uid+'/role').val()==='warehouse')&&root.child('users/'+auth.uid+'/aktif').val()===true)||(root.child('events/'+$eid+'/teknisi/'+auth.uid).exists()&&root.child('users/'+auth.uid+'/aktif').val()===true)",
          ".validate": "newData.hasChildren(['ok','uid','waktu'])&&newData.child('uid').val()===auth.uid"
        }
      }
    },
    "kategori": {
      ".read": "auth!=null&&root.child('users/'+auth.uid+'/aktif').val()===true",
      "$id": {
        ".write": "(root.child('users/'+auth.uid+'/role').val()==='admin'||root.child('users/'+auth.uid+'/role').val()==='warehouse')&&root.child('users/'+auth.uid+'/aktif').val()===true",
        ".validate": "newData.hasChildren(['nama'])"
      }
    },
    "bulk": {
      ".read": "auth!=null&&root.child('users/'+auth.uid+'/aktif').val()===true",
      "$id": {
        ".write": "(root.child('users/'+auth.uid+'/role').val()==='admin'&&root.child('users/'+auth.uid+'/aktif').val()===true)||((root.child('users/'+auth.uid+'/role').val()==='warehouse'&&root.child('users/'+auth.uid+'/aktif').val()===true)&&newData.exists())",
        ".validate": "newData.hasChildren(['nama','total'])&&newData.child('total').isNumber()&&newData.child('total').val()>=0"
      }
    },
    "bulkEvent": {
      ".read": "auth!=null&&root.child('users/'+auth.uid+'/aktif').val()===true",
      "$eid": {
        "$bid": {
          ".write": "((root.child('users/'+auth.uid+'/role').val()==='admin'&&root.child('users/'+auth.uid+'/aktif').val()===true)||(root.child('users/'+auth.uid+'/role').val()==='warehouse'&&root.child('users/'+auth.uid+'/aktif').val()===true))||(root.child('users/'+auth.uid+'/aktif').val()===true&&root.child('events/'+$eid+'/teknisi/'+auth.uid).exists()&&((data.child('tahap').val()==='keluar'&&newData.child('tahap').val()==='diterima')||(data.child('tahap').val()==='diterima'&&newData.child('tahap').val()==='kembali')))",
          ".validate": "newData.hasChildren(['qty','mulai','selesai','tahap'])&&newData.child('qty').isNumber()&&newData.child('qty').val()>0&&newData.child('tahap').val().matches(/^(rencana|keluar|diterima|kembali|selesai)$/)"
        }
      }
    }
  }
}