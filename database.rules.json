{
  "rules": {
    ".read": false,
    ".write": false,
    "users": {
      ".read": "root.child('users/'+auth.uid+'/role').val()==='admin'&&root.child('users/'+auth.uid+'/aktif').val()===true",
      "$uid": {
        ".read": "auth!=null&&(auth.uid===$uid||root.child('users/'+auth.uid+'/role').val()==='admin'&&root.child('users/'+auth.uid+'/aktif').val()===true)",
        ".write": "root.child('users/'+auth.uid+'/role').val()==='admin'&&root.child('users/'+auth.uid+'/aktif').val()===true",
        ".validate": "newData.hasChildren(['nama','role','aktif'])",
        "nama": {
          ".validate": "newData.isString()&&newData.val().length>0&&newData.val().length<=100"
        },
        "aktif": {
          ".validate": "newData.isBoolean()"
        },
        "role": {
          ".validate": "newData.val().matches(/^(admin|warehouse|teknisi)$/)"
        },
        "wajibGanti": {
          ".write": "auth!=null&&auth.uid===$uid&&root.child('users/'+auth.uid+'/aktif').val()===true",
          ".validate": "newData.isBoolean()"
        }
      }
    },
    "assets": {
      ".read": "auth!=null&&root.child('users/'+auth.uid+'/aktif').val()===true",
      "$id": {
        ".write": "(root.child('users/'+auth.uid+'/role').val()==='admin'||root.child('users/'+auth.uid+'/role').val()==='warehouse')&&root.child('users/'+auth.uid+'/aktif').val()===true",
        ".validate": "newData.hasChildren(['kode','status'])",
        "status": {
          ".validate": "newData.val().matches(/^(tersedia|dialokasikan|disiapkan|keluar|diterima|digunakan|menunggu_kembali|servis|rusak|hilang|pensiun)$/)"
        }
      }
    },
    "events": {
      ".read": "auth!=null&&root.child('users/'+auth.uid+'/aktif').val()===true",
      "$id": {
        ".write": "(root.child('users/'+auth.uid+'/role').val()==='admin'||root.child('users/'+auth.uid+'/role').val()==='warehouse')&&root.child('users/'+auth.uid+'/aktif').val()===true",
        ".validate": "newData.hasChildren(['nama','mulai','selesai'])",
        "tahap": {
          ".write": "root.child('users/'+auth.uid+'/aktif').val()===true&&root.child('events/'+$id+'/teknisi/'+auth.uid).exists()&&((data.val()==='dikirim'&&newData.val()==='diterima')||(data.val()==='diterima'&&newData.val()==='kembali'))",
          ".validate": "newData.val().matches(/^(rencana|siap|dikirim|diterima|kembali|selesai)$/)"
        },
        "diterimaWaktu": {
          ".write": "root.child('users/'+auth.uid+'/aktif').val()===true&&root.child('events/'+$id+'/teknisi/'+auth.uid).exists()"
        },
        "diterimaOleh": {
          ".write": "root.child('users/'+auth.uid+'/aktif').val()===true&&root.child('events/'+$id+'/teknisi/'+auth.uid).exists()"
        },
        "kembaliWaktu": {
          ".write": "root.child('users/'+auth.uid+'/aktif').val()===true&&root.child('events/'+$id+'/teknisi/'+auth.uid).exists()"
        },
        "kembaliOleh": {
          ".write": "root.child('users/'+auth.uid+'/aktif').val()===true&&root.child('events/'+$id+'/teknisi/'+auth.uid).exists()"
        }
      }
    },
    "transactions": {
      ".read": "(root.child('users/'+auth.uid+'/role').val()==='admin'||root.child('users/'+auth.uid+'/role').val()==='warehouse')&&root.child('users/'+auth.uid+'/aktif').val()===true",
      ".indexOn": [
        "assetId"
      ],
      "$tx": {
        ".write": "!data.exists()&&(root.child('users/'+auth.uid+'/role').val()==='admin'||root.child('users/'+auth.uid+'/role').val()==='warehouse')&&root.child('users/'+auth.uid+'/aktif').val()===true",
        ".validate": "newData.hasChildren(['tipe','assetId','petugas','waktu'])&&newData.child('waktu').isNumber()",
        "petugas": {
          ".validate": "newData.val()===auth.uid"
        }
      }
    },
    "audit": {
      ".read": "root.child('users/'+auth.uid+'/role').val()==='admin'&&root.child('users/'+auth.uid+'/aktif').val()===true",
      "$id": {
        ".write": "!data.exists()&&auth!=null&&root.child('users/'+auth.uid+'/aktif').val()===true",
        ".validate": "newData.hasChildren(['uid','aksi','waktu'])&&newData.child('uid').val()===auth.uid&&newData.child('waktu').isNumber()"
      }
    },
    "laporanRusak": {
      ".read": "(root.child('users/'+auth.uid+'/role').val()==='admin'||root.child('users/'+auth.uid+'/role').val()==='warehouse')&&root.child('users/'+auth.uid+'/aktif').val()===true",
      "$id": {
        ".write": "!data.exists()&&auth!=null&&root.child('users/'+auth.uid+'/aktif').val()===true",
        ".validate": "newData.hasChildren(['assetId','uid','catatan','waktu'])&&newData.child('uid').val()===auth.uid&&newData.child('catatan').isString()&&newData.child('catatan').val().length<=1000"
      }
    },
    "serahTerima": {
      ".read": "auth!=null&&root.child('users/'+auth.uid+'/aktif').val()===true",
      "$eid": {
        "$rid": {
          ".write": "!data.exists()&&root.child('users/'+auth.uid+'/aktif').val()===true&&((root.child('users/'+auth.uid+'/role').val()==='admin'||root.child('users/'+auth.uid+'/role').val()==='warehouse')||root.child('events/'+$eid+'/teknisi/'+auth.uid).exists())",
          ".validate": "newData.hasChildren(['tipe','uid','waktu'])&&newData.child('uid').val()===auth.uid&&newData.child('tipe').val().matches(/^(keluar|terima|kembali)$/)"
        }
      }
    },
    "checklist": {
      "$eid": {
        ".read": "auth!=null&&root.child('users/'+auth.uid+'/aktif').val()===true",
        "$aid": {
          ".write": "((root.child('users/'+auth.uid+'/role').val()==='admin'||root.child('users/'+auth.uid+'/role').val()==='warehouse')&&root.child('users/'+auth.uid+'/aktif').val()===true)||(root.child('users/'+auth.uid+'/aktif').val()===true&&root.child('events/'+$eid+'/teknisi/'+auth.uid).exists())",
          ".validate": "newData.hasChildren(['ok','uid','waktu'])&&newData.child('uid').val()===auth.uid"
        }
      }
    },
    "notifications": {
      "$uid": {
        ".read": "auth!=null&&auth.uid===$uid&&root.child('users/'+auth.uid+'/aktif').val()===true",
        ".indexOn": [
          "waktu"
        ],
        "$id": {
          ".write": "!data.exists()&&(root.child('users/'+auth.uid+'/role').val()==='admin'||root.child('users/'+auth.uid+'/role').val()==='warehouse')&&root.child('users/'+auth.uid+'/aktif').val()===true",
          ".validate": "newData.hasChildren(['judul','pesan','waktu','dari'])&&newData.child('dari').val()===auth.uid&&newData.child('judul').val().length<=200&&newData.child('pesan').val().length<=600"
        }
      }
    },
    "notifRole": {
      "$role": {
        ".read": "auth!=null&&root.child('users/'+auth.uid+'/role').val()===$role&&root.child('users/'+auth.uid+'/aktif').val()===true",
        ".indexOn": [
          "waktu"
        ],
        "$id": {
          ".write": "!data.exists()&&root.child('users/'+auth.uid+'/aktif').val()===true&&($role==='admin'||$role==='warehouse')",
          ".validate": "newData.hasChildren(['judul','pesan','waktu','dari'])&&newData.child('dari').val()===auth.uid&&newData.child('judul').val().length<=200&&newData.child('pesan').val().length<=600"
        }
      }
    },
    "notifSeen": {
      "$uid": {
        ".read": "auth!=null&&auth.uid===$uid",
        ".write": "auth!=null&&auth.uid===$uid",
        ".validate": "newData.isNumber()"
      }
    },
    "fcmTokens": {
      ".read": false,
      "$uid": {
        "$token": {
          ".write": "auth!=null&&auth.uid===$uid&&root.child('users/'+auth.uid+'/aktif').val()===true"
        }
      }
    }
  }
}